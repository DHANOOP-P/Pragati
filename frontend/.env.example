# Leave empty locally — Vite proxies /api to http://localhost:5000
# Production (Vercel): the public URL of the hosted Express API, including /api
# VITE_API_URL=https://your-api.onrender.com/api
VITE_API_URL=

# Public site origin used in SEO canonical tags (no trailing slash)
# VITE_SITE_URL=https://pragati-ten-azure.vercel.app
VITE_SITE_URL=https://pragati-ten-azure.vercel.app/
